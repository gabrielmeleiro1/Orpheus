{
  "name": "orpheus-desktop",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:install": "python ../scripts/install_desktop_app.py",
    "desktop:release": "tauri build && python ../scripts/install_desktop_app.py --remove-source-after-install"
  },
  "knip": {
    "entry": [
      "src/test/conversionLayoutHarness.tsx",
      "src/test/performanceHarness.tsx"
    ]
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tauri-apps/api": "2.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "happy-dom": "21.0.4",
    "typescript": "^5.6.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
