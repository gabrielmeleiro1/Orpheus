{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orpheus",
  "version": "1.0.0",
  "identifier": "com.orpheus.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --host localhost --port 5173 --strictPort",
    "beforeBuildCommand": "python ../scripts/build_desktop_backend.py && npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Orpheus",
        "width": 1200,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:*; media-src 'self' asset: http://asset.localhost http://127.0.0.1:* data: blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "binaries": "binaries",
      "../../LICENSE": "LICENSE",
      "../../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md"
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    }
  }
}
