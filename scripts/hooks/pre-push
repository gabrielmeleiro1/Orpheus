#!/usr/bin/env bash
# Block pushes unless the local validation suite passes.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$ROOT"

python_supports_validation() {
  "$1" - <<'PY'
from __future__ import annotations

import sys

raise SystemExit(0 if sys.version_info[:2] == (3, 12) else 1)
PY
}

if [[ -x "$ROOT/.venv/bin/python" ]]; then
  PYTHON="$ROOT/.venv/bin/python"
elif [[ -x "$ROOT/.venv/Scripts/python.exe" ]]; then
  PYTHON="$ROOT/.venv/Scripts/python.exe"
elif command -v python >/dev/null 2>&1 && python_supports_validation "$(command -v python)"; then
  PYTHON="$(command -v python)"
elif command -v python3.12 >/dev/null 2>&1; then
  PYTHON="$(command -v python3.12)"
else
  echo "Python 3.12 is required for local validation. Create the project .venv or install python3.12." >&2
  exit 1
fi

run_with_timeout() {
  local seconds="$1"
  shift
  "$PYTHON" - "$seconds" "$@" <<'PY'
from __future__ import annotations

import subprocess
import shutil
import sys

seconds = int(sys.argv[1])
command = sys.argv[2:]
# Windows CreateProcess does not apply PATHEXT when given bare "npm".
# Resolve npm.cmd (and other shims) before launching, without a shell command.
command[0] = shutil.which(command[0]) or command[0]
try:
    completed = subprocess.run(command, timeout=seconds)
except subprocess.TimeoutExpired:
    print(
        f"Command timed out after {seconds}s: {' '.join(command)}",
        file=sys.stderr,
    )
    raise SystemExit(124)
raise SystemExit(completed.returncode)
PY
}

echo ""
echo "============================================================"
echo "   ORPHEUS - PRE-PUSH VALIDATION"
echo "============================================================"
echo ""

echo "Remote: ${1:-unknown}"
echo "URL: ${2:-unknown}"
echo ""

if ! command -v ffmpeg >/dev/null 2>&1; then
  echo "ffmpeg is required for local validation. Install it before pushing." >&2
  exit 1
fi

echo "> Ruff"
run_with_timeout 120 "$PYTHON" -m ruff check .

echo ""
echo "> Python contract tests"
run_with_timeout 600 "$PYTHON" -m pytest tests \
  -m "not property and not benchmark and not slow and not ui"

echo ""
echo "> Desktop dependencies"
(
  cd desktop
  run_with_timeout 180 npm ci
)

echo ""
echo "> Desktop typecheck"
(
  cd desktop
  run_with_timeout 180 npm run typecheck
)

echo ""
echo "> Desktop Vitest"
(
  cd desktop
  run_with_timeout 180 npm test -- --run
)

echo ""
echo "> Tauri resource directories"
mkdir -p desktop/src-tauri/binaries

echo ""
echo "> Tauri tests"
(
  cd desktop/src-tauri
  CARGO_BUILD_JOBS=1 run_with_timeout 900 cargo test
)

echo ""
echo "> Tauri check"
(
  cd desktop/src-tauri
  CARGO_BUILD_JOBS=1 run_with_timeout 600 cargo check
)

echo ""
echo "PRE-PUSH VALIDATION PASSED"
echo ""
