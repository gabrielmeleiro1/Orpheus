# Coverage configuration (read by coverage.py; pytest-cov discovers this file
# automatically). Keep coverage settings here, not in pytest.ini -- coverage.py
# never reads pytest.ini.
[run]
source = modules
parallel = True
data_file = .artifacts/coverage/.coverage
omit =
    */tests/*
    */test_*
    */venv/*
    */__pycache__/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__.:
    raise NotImplementedError
    # Anchored: exclude_lines patterns are re.search, so a bare `pass` would
    # also drop any line merely containing the substring (meipass_dir, and
    # "password", among others).
    ^\s*pass$
    if TYPE_CHECKING:
    except ImportError:
    # Debug code
