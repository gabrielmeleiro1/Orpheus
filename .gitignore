# OS metadata
.DS_Store

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/

# Python packaging output
.eggs/
*.egg-info/
/build/
/dist/

# Virtual environments and local env files
.venv/
venv/
.env
.env.*
!.env.example

# Local tool and editor state
.artifacts/
.claude/

# Coverage and logs
.coverage
.coverage.*
coverage.xml
htmlcov/
*.log

# Desktop build output
node_modules/
*.tsbuildinfo
desktop/dist/
desktop/release/
desktop/src-tauri/target/
desktop/src-tauri/binaries/*
!desktop/src-tauri/binaries/.gitkeep

# Local runtime state. A backend run from the checkout keeps setup state beside
# its data directory, so the root-level files belong here too.
data/*
!data/README.md
/backend-instance.json
/backend-ready.json
/runtime-setup.json
/runtime-setup.json.*
tests/data/*.db
tests/data/*.db-shm
tests/data/*.db-wal
output/
temp/
tmp/

# Generated media and local source corpora
*.m4b
*.mp3
test_books/
