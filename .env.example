# Local runtime paths
# Leave these as relative paths for the default local workspace layout.
AUDIOBOOK_DATA_DIR=data
AUDIOBOOK_OUTPUT_DIR=output
AUDIOBOOK_TEMP_DIR=temp
AUDIOBOOK_DB_PATH=data/audiobooks.db

# Text cleaner backend
# "mlx"  — local MLX-LM on Apple Silicon (default)
# "cuda" — local Hugging Face / PyTorch on NVIDIA GPUs (headless/server)
# "api"  — OpenAI-compatible remote API
CLEANER_BACKEND=mlx
# Optional cleaner model override (defaults to the backend catalog when unset)
# CLEANER_MODEL_NAME=mlx-community/Llama-3.2-3B-Instruct-4bit
# CUDA cleaner settings (used when CLEANER_BACKEND=cuda)
# CLEANER_CUDA_DEVICE=cuda
# CLEANER_CUDA_QUANTIZATION=4bit
CLEANER_API_BASE_URL=https://api.openai.com/v1
CLEANER_API_KEY_ENV=OPENAI_API_KEY
CLEANER_API_MODEL=gpt-5-nano
CLEANER_API_GLOBAL_CONCURRENCY=6

# Never commit a real API key. Copy this file to .env.local and set it there.
OPENAI_API_KEY=

# Optional cleaner API TLS settings
# CLEANER_API_CA_BUNDLE=/absolute/path/to/ca-bundle.pem
# CLEANER_API_INSECURE_SSL=0

# Optional processing controls
AUDIOBOOK_ENABLE_PARALLEL=0
AUDIOBOOK_MAX_PARALLEL_CHAPTERS=4
WORKER_POOL_REUSE_ENABLED=1
SAVE_CLEANING_DEBUG=0
PDF_EXTRACTION_BACKEND=fitz

# Optional TTS runtime overrides
# TTS_PROVIDER=cpu
# TTS_DEVICE=
# TTS_MODEL_NAME=.artifacts/models/kokoro

# Optional FFmpeg overrides
# AUDIOBOOK_FFMPEG_PATH=/absolute/path/to/ffmpeg
# AUDIOBOOK_FFPROBE_PATH=/absolute/path/to/ffprobe
# AUDIOBOOK_FFMPEG_TIMEOUT_SECONDS=7200
