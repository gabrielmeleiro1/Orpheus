# Copy to .env.local for local overrides. Existing environment variables win.
# Every variable is documented in docs/ENVIRONMENT.md.

# Local runtime paths (the desktop app always sets its own)
# Leave these as relative paths for the default local workspace layout.
AUDIOBOOK_DATA_DIR=data
AUDIOBOOK_OUTPUT_DIR=output
AUDIOBOOK_TEMP_DIR=temp
AUDIOBOOK_DB_PATH=data/audiobooks.db

# Text cleaner backend. Saved desktop setup replaces these cleaner settings.
# "basic" - rule-based cleanup, no model
# "mlx"   - local MLX-LM on Apple Silicon (default)
# "cuda"  - local Hugging Face / PyTorch on NVIDIA GPUs
# "api"   - OpenAI-compatible remote API
CLEANER_BACKEND=mlx
# Optional cleaner model override (defaults to the backend catalog when unset)
# CLEANER_MODEL_NAME=mlx-community/Llama-3.2-3B-Instruct-4bit
# CUDA cleaner settings (used when CLEANER_BACKEND=cuda); precision is
# 4bit, 8bit, or fp16. Inline comments are not supported in values.
# CLEANER_CUDA_DEVICE=cuda
# CLEANER_CUDA_QUANTIZATION=4bit
CLEANER_API_BASE_URL=https://api.openai.com/v1
CLEANER_API_KEY_ENV=OPENAI_API_KEY
CLEANER_API_MODEL=gpt-5-nano
CLEANER_API_GLOBAL_CONCURRENCY=6

# API key for the "api" cleaner and voice suggestions. CLEANER_API_KEY_ENV
# names the variable that holds it. Never commit a real key: copy this file to
# .env.local (ignored by Git) and set it there.
OPENAI_API_KEY=

# Optional cleaner API TLS settings
# CLEANER_API_CA_BUNDLE=/absolute/path/to/ca-bundle.pem
# CLEANER_API_INSECURE_SSL=0

# Optional processing controls
AUDIOBOOK_ENABLE_PARALLEL=0
AUDIOBOOK_MAX_PARALLEL_CHAPTERS=4
# Encode chapter AAC while synthesis continues, then package the M4B from those
# streams. Set to 0 to use the legacy end-of-run packaging path.
AUDIOBOOK_ENABLE_CHAPTER_AAC_PACKAGING=1
# Keep intermediate per-chapter MP3 files.
# AUDIOBOOK_EMIT_CHAPTER_MP3_ARTIFACTS=0
WORKER_POOL_REUSE_ENABLED=1
SAVE_CLEANING_DEBUG=0
PDF_EXTRACTION_BACKEND=fitz

# Optional TTS runtime overrides
# TTS_PROVIDER=cpu
# TTS_DEVICE=
# TTS_MODEL_NAME=.artifacts/models/kokoro
# torch.compile the CUDA/CPU Kokoro synthesis hot path. One-time compile cost
# (tens of seconds per process, amortized by the inductor disk cache) for
# ~1.4x faster synthesis; worthwhile for book-length conversions on CUDA.
# AUDIOBOOK_TTS_TORCH_COMPILE=1

# Optional FFmpeg overrides
# AUDIOBOOK_FFMPEG_PATH=/absolute/path/to/ffmpeg
# AUDIOBOOK_FFPROBE_PATH=/absolute/path/to/ffprobe
# AUDIOBOOK_FFMPEG_TIMEOUT_SECONDS=7200
